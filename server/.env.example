# 复制为 server/.env 后按需修改（不建也行，以下都是默认值）

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# 默认对话模型
OLLAMA_MODEL=qwen2.5:7b

# 后端端口
PORT=3000

# ===== 联网搜索 =====
# 默认免 Key 多引擎：百度 → 搜狗 → 必应cn（国内均可访问），全部失败回退 DuckDuckGo / Wikipedia。
# 可指定主引擎：SEARCH_PROVIDER=baidu（默认）| sogou | bing
# SEARCH_PROVIDER=sogou

# 若想要更稳定的官方接口，可申请 Bing Search API Key：
# SEARCH_API_KEY=你的Key
# SEARCH_PROVIDER=bing
